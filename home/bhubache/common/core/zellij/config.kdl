default_layout "compact"
pane_frames false
keybinds {
  normal {
    unbind "Ctrl o"
    bind "Ctrl m" { MoveFocus "left"; }
    bind "Ctrl n" { MoveFocus "down"; }
    bind "Ctrl e" { MoveFocus "up"; }
    bind "Ctrl i" { MoveFocus "right"; }
    bind "Ctrl Alt i" { GoToNextTab; }
    bind "Ctrl Alt m" { GoToPreviousTab; }
    bind "Ctrl Alt Shift m" { MoveTab "Left"; }
    bind "Ctrl Alt Shift i" { MoveTab "Right"; }
  }
  pane {
    bind "m" { NewPane "left"; MoveFocus "left"; SwitchToMode "Normal"; Clear; }
    bind "n" { NewPane "down"; SwitchToMode "Normal"; Clear; }
    bind "e" { NewPane "up"; MoveFocus "up"; SwitchToMode "Normal"; Clear; }
    bind "i" { NewPane "right"; SwitchToMode "Normal"; Clear; }
  }
  tab {
    bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
  }
  session {
    bind "Ctrl x" { SwitchToMode "Normal"; }
  }
  shared_except "pane" "locked" {
    bind "Ctrl a" { SwitchToMode "Pane"; }
  }
  shared_except "session" "locked" {
    bind "Ctrl x" { SwitchToMode "Session"; }
  }
}

theme "onedark"

plugins {
  zellij-forgot location="zellij:zellij-forgot"
}
